# ---- Gauge ortam değişkenleri ----
# Hiçbiri zorunlu değil: anahtar yoksa ilgili entegrasyon "mock" moduna düşer,
# böylece `npm run demo` internet/anahtar olmadan da uçtan uca çalışır.

# Veritabanı (Faz 1 API/worker için)
DATABASE_URL="postgresql://gauge:gauge@localhost:5432/gauge?schema=public"

# Redis (kuyruk + cache)
REDIS_URL="redis://localhost:6379"

# Anthropic — AI-izleme motorunun bahsedilme analizi + aksiyon planı için
ANTHROPIC_API_KEY=""
# Ucuz sınıflandırma modeli (bahsedilme tespiti). Boşsa varsayılan kullanılır.
GAUGE_MENTION_MODEL="claude-haiku-4-5"
# İçgörü/aksiyon üretimi modeli.
GAUGE_INSIGHT_MODEL="claude-opus-5"

# Yerel sıralama / harita verisi (biri yeterli). Boşsa mock veri döner.
SERPAPI_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# AI motorlarının resmi API'leri (boşsa mock cevap döner)
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""

# Meta & Google Business Profile (OAuth — Faz 3)
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

PORT="4000"
